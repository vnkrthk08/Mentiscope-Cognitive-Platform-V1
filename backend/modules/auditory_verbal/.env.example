# ============================================================
# MentiScope Backend Configuration Reference (.env.example)
# Duplicate this file to '.env' in the backend directory.
# ============================================================

# ------------------------------------------------------------
# 1. Project & Application Meta
# ------------------------------------------------------------
PROJECT_NAME="MentiScope Cognitive Assessment Engine"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# ------------------------------------------------------------
# 2. Security & JWT Settings
# IMPORTANT: Change SECRET_KEY in production!
# ------------------------------------------------------------
SECRET_KEY="SUPER_SECRET_PRODUCTION_KEY_MENTISCOPE_2026_CHANGE_IN_ENV"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------
# 3. Database Configuration (PostgreSQL Async via asyncpg)
# ------------------------------------------------------------
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="mentiscope_user"
POSTGRES_PASSWORD="mentiscope_password"
POSTGRES_DB="mentiscope_db"
DATABASE_URL="postgresql+asyncpg://mentiscope_user:mentiscope_password@localhost:5432/mentiscope_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------
# 4. Redis Cache Configuration
# ------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# ------------------------------------------------------------
# 5. Storage Paths & Config Repository
# ------------------------------------------------------------
CONFIG_REPO_PATH="./config_repo"
AUDIO_STORAGE_PATH="./storage/audio"

# ------------------------------------------------------------
# 6. AI Providers & Speech Engines
# Pluggable adapters: Whisper (STT), OpenAI / Gemini / Claude (LLM)
# If API keys are empty, system uses simulated adapter logic.
# ------------------------------------------------------------
SPEECH_PROVIDER="Whisper"
LLM_PROVIDER="openrouter"
LLM_MODE="real"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
NVIDIA_API_KEY=""
OPENROUTER_API_KEY=""


# ------------------------------------------------------------
# 7. Feature Flags
# ------------------------------------------------------------
ENABLE_ADAPTIVE_FOLLOWUP=True
ENABLE_LLM_EVALUATION=True
ENABLE_RESEARCH_ANALYTICS=True
STRICT_SECURITY_POLICIES=True
