                "type": "null"
              }
            ],
            "title": "Student Id"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "StartRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
