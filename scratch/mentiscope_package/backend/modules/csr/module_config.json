{
  "module_id": "csr",
  "module_name": "Classroom Scenario Recall (CSR)",
  "construct": "Gsm",
  "construct_name": "Working Memory",
  "version": "v0.1-mvp",
  "description": "Four-part working memory assessment: Auditory Recall, Visual Grid Memory, Distractor Challenge (interference resistance), and Sequential Recall (updating).",
  "total_trials": 10,
  "sub_components": [
    { "key": "auditory_memory", "task_id": "auditory", "item_prefix": "AUD", "trials": 2 },
    { "key": "visual_memory", "task_id": "visual", "item_prefix": "VIS", "trials": 2 },
    { "key": "interference_resistance", "task_id": "distractor", "item_prefix": "DIS", "trials": 4 },
    { "key": "sequential_recall", "task_id": "sequential", "item_prefix": "SEQ", "trials": 2 }
  ],
  "scoring_model": {
    "raw_score": "mean of the four sub-component accuracy percentages, equally weighted (25% each)",
    "normalized_score": "100 + (raw_score - 75) * 0.6",
    "percentile": "clamp(1, 99, round(50 + (raw_score - 75) * 1.2))",
    "confidence_score": "0.82 if responses >= 8 else 0.55"
  },
  "api": {
    "base_path": "/api/modules/csr",
    "endpoints": ["POST /start", "POST /answer", "POST /finish", "GET /result"]
  },
  "shared_tables": ["sessions", "responses", "events", "results", "analytics"],
  "notes": "No module-specific database table is created; all persistence uses the shared MentiScope schema per platform guidelines."
}
