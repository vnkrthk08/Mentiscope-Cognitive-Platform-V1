# ASAT – Environment Variables Example
# Do not commit the real .env file to version control.
# Copy this file to .env and replace with your actual values.

# ── Database (PostgreSQL) ──
# These can be customized when deploying to the shared MentiScope platform
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=asat
DB_USER=postgres
DB_PASSWORD=<YOUR_PASSWORD>

# ── Application ──
APP_PORT=8000
APP_SECRET_KEY=generate_a_secure_random_string_here_for_sessions
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Module Identity (MentiScope Integration) ──
# Default values according to technical specs
MODULE_ID=asat_attention
MODULE_NAME=Adaptive Shape Attention Task
CONSTRUCT=Attention
